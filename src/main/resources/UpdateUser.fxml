<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UpdateUserController" stylesheets="@style.css">
    <left>
        <VBox styleClass="sidebar">
            <Label text="BLADNA" styleClass="sidebar-title"/>
            <Label text="Update User" styleClass="sidebar-subtitle"/>
            
            <Region prefHeight="20"/>

            <Button text="Back" onAction="#goBack" styleClass="nav-button">
                <graphic>
                    <Label text="&#x2B05;" styleClass="icon-label"/>
                </graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="content-area">
            <VBox styleClass="page-card" maxWidth="680">
                <Label text="Edit User Details" styleClass="title"/>
                <Label fx:id="subtitleLabel" text="Modify credentials for the selected user." styleClass="subtitle" wrapText="true"/>

                <GridPane styleClass="form-grid" vgap="5" hgap="10">
                    <Label text="First name" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="firstNameField" promptText="First name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label fx:id="firstNameHintLabel" text="First name must be at least 3 characters." styleClass="validation-hint" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Last name" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="lastNameField" promptText="Last name" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label fx:id="lastNameHintLabel" text="Last name must be at least 3 characters." styleClass="validation-hint" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Email" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="emailField" promptText="New email" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Stored password" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <TextField fx:id="storedPasswordField" editable="false" focusTraversable="false" promptText="Visible only for admin" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                    <Label text="Stored bcrypt passwords cannot be decrypted. You can set a new password below." styleClass="password-info" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                    <Label text="New password (optional)" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                    <PasswordField fx:id="newPasswordField" promptText="Leave empty to keep current password" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                    <TextField fx:id="newPasswordVisibleField" promptText="Leave empty to keep current password" visible="false" managed="false" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                    <CheckBox fx:id="showPasswordCheckBox" text="Show password" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                    <Label fx:id="newPasswordHintLabel" text="Password must be at least 8 characters when provided." styleClass="validation-hint" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                </GridPane>

                <HBox spacing="10" styleClass="action-bar">
                    <Button fx:id="saveChangesButton" text="Save Changes" onAction="#handleSave" styleClass="primary-button"/>
                    <Button text="Cancel" onAction="#goBack" styleClass="secondary-button"/>
                </HBox>

                <Label fx:id="messageLabel" styleClass="status-message" wrapText="true" visible="false" managed="false"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
