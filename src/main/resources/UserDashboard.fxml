<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.UserDashboardController" stylesheets="@style.css">
    <left>
        <VBox styleClass="sidebar, sidebar-user">
            <Label text="BLADNA" styleClass="sidebar-title"/>
            <Label text="User Panel" styleClass="sidebar-subtitle"/>
            
            <Region prefHeight="20"/>
            
            <Button text="Dashboard" styleClass="nav-button, nav-button-active">
                <graphic>
                    <Label text="&#x1F3E0;" styleClass="icon-label"/>
                </graphic>
            </Button>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <Button text="Delete Account" onAction="#handleDeleteAccount" styleClass="nav-button, nav-button-logout">
                <graphic>
                    <Label text="&#x1F5D1;" styleClass="icon-label"/>
                </graphic>
            </Button>
            <Button text="Logout" onAction="#logout" styleClass="nav-button, nav-button-logout">
                <graphic>
                    <Label text="&#x2B05;" styleClass="icon-label"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="content-area">
            <VBox spacing="24">
                <!-- Welcome Header -->
                <VBox styleClass="page-card" spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox HBox.hgrow="ALWAYS" spacing="4">
                            <Label fx:id="welcomeLabel" text="Welcome!" styleClass="title"/>
                            <Label text="Your personal dashboard overview" styleClass="subtitle"/>
                        </VBox>
                        <Label fx:id="roleBadgeLabel" text="User" styleClass="role-badge"/>
                    </HBox>
                </VBox>

                <!-- Profile Card -->
                <VBox styleClass="page-card" spacing="16">
                    <Label text="Profile Information" styleClass="section-title"/>
                    
                    <VBox spacing="12" styleClass="profile-info-grid">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="&#x1F464;" styleClass="icon-label"/>
                            <VBox spacing="2">
                                <Label text="Full Name" styleClass="profile-field-label"/>
                                <Label fx:id="nameLabel" text="-" styleClass="profile-field-value"/>
                            </VBox>
                        </HBox>
                        
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="&#x2709;" styleClass="icon-label"/>
                            <VBox spacing="2">
                                <Label text="Email" styleClass="profile-field-label"/>
                                <Label fx:id="emailLabel" text="-" styleClass="profile-field-value"/>
                            </VBox>
                        </HBox>
                        
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="&#x1F3AF;" styleClass="icon-label"/>
                            <VBox spacing="2">
                                <Label text="Role" styleClass="profile-field-label"/>
                                <Label fx:id="roleLabel" text="-" styleClass="profile-field-value"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>

