<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.NotificationsWindowController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15" />
    </padding>
    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="🔔 zTalk" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f766e;" />
                <Label text="Notifications" style="-fx-font-size: 16px; -fx-text-fill: #475569;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="✕" onAction="#closeWindow" style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-cursor: hand;" />
            </children>
        </HBox>

        <!-- Séparateur -->
        <Region style="-fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;" />

        <!-- Liste des notifications -->
        <ListView fx:id="notificationsListView" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;" />

        <!-- Message si aucune notification -->
        <Label fx:id="emptyLabel" text="Aucune notification" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-alignment: center;" />
    </children>
</VBox>