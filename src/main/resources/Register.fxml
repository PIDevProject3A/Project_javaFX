<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="app-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.RegisterController" stylesheets="@style.css">
    <VBox spacing="12">
        <!-- Appearance Control Bar -->
        <HBox fx:id="appearanceBar" spacing="12" alignment="TOP_RIGHT">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
        </HBox>
        
        <VBox styleClass="page-card" spacing="12" maxWidth="740">
        <Label text="%register.title" styleClass="title"/>
        <Label text="%register.subtitle" styleClass="subtitle" wrapText="true"/>

        <GridPane styleClass="form-grid">
            <Label text="%register.firstname" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="firstNameField" promptText="%register.firstname" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label fx:id="firstNameHintLabel" text="%register.hint.firstname" styleClass="validation-hint" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="%register.lastname" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="lastNameField" promptText="%register.lastname" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label fx:id="lastNameHintLabel" text="%register.hint.lastname" styleClass="validation-hint" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="%login.email" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="emailField" promptText="%login.email" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="%login.password" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <PasswordField fx:id="passwordField" promptText="%login.password" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            <Label fx:id="passwordHintLabel" text="%register.hint.password" styleClass="validation-hint" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

            <Label text="%register.role" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
            <ComboBox fx:id="adminTypeBox" promptText="%register.role" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
        </GridPane>

        <HBox spacing="10">
            <Button fx:id="registerButton" text="%register.btn.register" onAction="#handleRegister" styleClass="primary-button"/>
            <Button text="%register.btn.back" onAction="#goToLogin" styleClass="secondary-button"/>
        </HBox>

        <Label fx:id="messageLabel" styleClass="status-message" wrapText="true" visible="false" managed="false"/>
        </VBox>
    </VBox>
    <padding>
        <Insets top="26" right="26" bottom="26" left="26"/>
    </padding>
</StackPane>

