<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ModifyCredentialsController" stylesheets="@style.css">
    <left>
        <VBox styleClass="sidebar">
            <Label text="Green Desk" styleClass="sidebar-title"/>
            <Label text="Credential center" styleClass="sidebar-subtitle"/>
            <Button text="[Back] Dashboard" onAction="#goBack" styleClass="nav-button"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="content-area">
            <VBox styleClass="page-card" maxWidth="780">
                <Label text="Accounts Credentials" styleClass="title"/>
                <Label text="Select an account from the list, then modify or delete it. Admin can edit self and other users." styleClass="subtitle" wrapText="true"/>

                <Label text="Users list" styleClass="section-title"/>
                <TableView fx:id="accountsTable" prefHeight="210" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Name"/>
                        <TableColumn fx:id="emailColumn" text="Email"/>
                        <TableColumn fx:id="roleColumn" text="Role"/>
                    </columns>
                </TableView>

                <GridPane styleClass="form-grid">
                    <Label text="First name" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="newFirstNameField" promptText="First name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label fx:id="newFirstNameHintLabel" text="First name must be at least 3 characters." styleClass="validation-hint" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Last name" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="newLastNameField" promptText="Last name" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label fx:id="newLastNameHintLabel" text="Last name must be at least 3 characters." styleClass="validation-hint" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Email" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="newEmailField" promptText="New email" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Stored password" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <TextField fx:id="storedPasswordField" editable="false" focusTraversable="false" promptText="Visible only for admin" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                    <Label text="Stored bcrypt passwords cannot be decrypted. You can set a new password below." styleClass="password-info" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                    <Label text="New password (optional)" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                    <PasswordField fx:id="newPasswordField" promptText="Leave empty to keep current password" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                    <TextField fx:id="newPasswordVisibleField" promptText="Leave empty to keep current password" visible="false" managed="false" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                    <CheckBox fx:id="showPasswordCheckBox" text="Show password" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                    <Label fx:id="newPasswordHintLabel" text="Password must be at least 8 characters when provided." styleClass="validation-hint" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                </GridPane>

                <HBox spacing="10">
                    <Button fx:id="saveChangesButton" text="Save Changes" onAction="#handleUpdateCredentials" styleClass="primary-button"/>
                    <Button fx:id="deleteSelectedButton" text="Delete Selected" onAction="#handleDeleteSelectedAccount" styleClass="danger-button"/>
                    <Button text="Back" onAction="#goBack" styleClass="secondary-button"/>
                </HBox>

                <Label fx:id="messageLabel" styleClass="status-message" wrapText="true"/>
            </VBox>
            <padding>
                <Insets top="6" right="6" bottom="6" left="6"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>
