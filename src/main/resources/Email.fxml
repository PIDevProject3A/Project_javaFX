<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.EmailController" stylesheets="@style.css">
    <!-- Padding global pour centrer la carte -->
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <center>
        <StackPane styleClass="content-area">
            <VBox styleClass="page-card" maxWidth="600" spacing="15">
                
                <Label text="Send Email" styleClass="title"/>
                <Label text="Contact users directly via Azure Communication Services." styleClass="subtitle" wrapText="true"/>

                <VBox spacing="8">
                    <Label text="Recipient" styleClass="form-label"/>
                    <TextField fx:id="toField" promptText="email@example.com"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Subject" styleClass="form-label"/>
                    <TextField fx:id="subjectField" promptText="Message Subject"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Message" styleClass="form-label"/>
                    <TextArea fx:id="messageArea" promptText="Type your message here..." prefRowCount="8" wrapText="true"/>
                </VBox>

                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="sendButton" text="Send" onAction="#handleSendEmail" styleClass="primary-button" prefWidth="120"/>
                    <Button text="Back" onAction="#goBack" styleClass="secondary-button" prefWidth="100"/>
                    <ProgressIndicator fx:id="loadingIndicator" visible="false" prefWidth="24" prefHeight="24"/>
                </HBox>

                <Label fx:id="statusLabel" styleClass="status-message" wrapText="true" visible="false" managed="false"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>

