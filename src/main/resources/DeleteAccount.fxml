<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.DeleteAccountController" stylesheets="@style.css">
    <left>
        <VBox styleClass="sidebar">
            <Label text="BLADNA" styleClass="sidebar-title"/>
            <Label text="Security" styleClass="sidebar-subtitle"/>
            
            <Region prefHeight="20"/>

            <Button text="Dashboard" onAction="#goBack" styleClass="nav-button">
                <graphic>
                    <Label text="&#x2B05;" styleClass="icon-label"/>
                </graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="content-area">
            <VBox styleClass="page-card" maxWidth="620">
                <Label text="Delete Account" styleClass="title"/>
                <Label text="This action is irreversible. Double check before confirming." styleClass="warning-text" wrapText="true"/>
                <Label text="You will be logged out immediately after deletion." styleClass="subtitle" wrapText="true"/>

                <HBox spacing="10">
                    <Button text="Delete My Account" onAction="#handleDeleteAccount" styleClass="danger-button">
                        <graphic>
                            <Label text="&#x1F5D1;" styleClass="icon-label"/>
                        </graphic>
                    </Button>
                    <Button text="Back" onAction="#goBack" styleClass="secondary-button"/>
                </HBox>

                <Label fx:id="messageLabel" styleClass="status-message" wrapText="true" visible="false" managed="false"/>
            </VBox>
            <padding>
                <Insets top="6" right="6" bottom="6" left="6"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>

