<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DeleteAccountController" stylesheets="@style.css">
    <left>
        <VBox styleClass="sidebar">
            <Label text="Green Desk" styleClass="sidebar-title"/>
            <Label text="Security" styleClass="sidebar-subtitle"/>
            <Button text="[Back] Dashboard" onAction="#goBack" styleClass="nav-button"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="content-area">
            <VBox styleClass="page-card" maxWidth="620">
                <Label text="Delete Account" styleClass="title"/>
                <Label text="Cette action est irreversible. Verifiez bien avant de confirmer." styleClass="warning-text" wrapText="true"/>
                <Label text="Vous serez deconnecte immediatement apres suppression." styleClass="subtitle" wrapText="true"/>

                <HBox spacing="10">
                    <Button text="Delete My Account" onAction="#handleDeleteAccount" styleClass="danger-button"/>
                    <Button text="Back" onAction="#goBack" styleClass="secondary-button"/>
                </HBox>

                <Label fx:id="messageLabel" styleClass="status-message" wrapText="true"/>
            </VBox>
            <padding>
                <Insets top="6" right="6" bottom="6" left="6"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>
