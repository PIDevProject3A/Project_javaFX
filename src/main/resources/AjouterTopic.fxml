<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AjouterTopic"
            minHeight="580.0" minWidth="540.0" prefHeight="640.0" prefWidth="620.0"
            styleClass="root-dialog social-dialog sm-modal-shell"
            stylesheets="@app.css">
    <children>
        <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="social-post-topbar" maxWidth="Infinity">
                    <children>
                        <Label styleClass="social-post-topbar-title" text="NEW TOPIC"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button mnemonicParsing="false" onAction="#goToList" styleClass="sm-topbar-close" text="Back"/>
                    </children>
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll"
                            vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="20.0" styleClass="dialog-card dialog-card-body" maxWidth="Infinity">
                            <padding>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="4.0"/>
                            </padding>
                            <children>
                                <Label styleClass="heading-dialog heading-dialog-hero" text="Create topic"/>
                                <Label styleClass="label-muted" wrapText="true"
                                       text="Dates are generated automatically and shown in the topic list."/>
                                <VBox spacing="16.0" maxWidth="Infinity">
                                    <children>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="field-label" text="Title"/>
                                                <TextField fx:id="Title" minHeight="40.0" styleClass="text-field-social"/>
                                                <Label fx:id="errTitle" managed="false" visible="false" styleClass="field-error"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="field-label" text="Text"/>
                                                <TextArea fx:id="contentArea" minHeight="120.0" prefRowCount="5" wrapText="true"
                                                          styleClass="text-area-social"/>
                                                <Label fx:id="errContent" managed="false" visible="false" styleClass="field-error"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="field-label" text="Category"/>
                                                <ComboBox fx:id="categoryCombo" minHeight="40.0" styleClass="combo-social"/>
                                                <Label fx:id="errCategory" managed="false" visible="false" styleClass="field-error"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="field-label" text="Status"/>
                                                <ComboBox fx:id="statusCombo" minHeight="40.0" styleClass="combo-social"/>
                                                <Label fx:id="errStatus" managed="false" visible="false" styleClass="field-error"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="field-label" text="Image (optional)"/>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Button mnemonicParsing="false" onAction="#chooseImage" styleClass="btn-secondary" text="Upload image"/>
                                                        <Label fx:id="imagePathLabel" styleClass="label-muted" text="No image selected"/>
                                                    </children>
                                                </HBox>
                                                <Label styleClass="label-muted" text="Max size: 5 MB"/>
                                                <ImageView fx:id="imagePreview" fitHeight="180.0" fitWidth="300.0" preserveRatio="true" smooth="true" visible="false" managed="false"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#goToList" styleClass="btn-secondary" text="Cancel"/>
                                        <Button defaultButton="true" mnemonicParsing="false" onAction="#Save" styleClass="btn-primary" text="Save"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
