<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ModifierTopicController"
            minHeight="580.0" minWidth="540.0" prefHeight="640.0" prefWidth="620.0"
            styleClass="root-dialog social-dialog sm-modal-shell"
            stylesheets="@app.css">
    <children>
        <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="social-post-topbar" maxWidth="Infinity">
                    <children>
                        <Label styleClass="social-post-topbar-title" text="EDIT · TOPIC"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button mnemonicParsing="false" onAction="#cancel" styleClass="sm-topbar-close" text="Close"/>
                    </children>
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll"
                            vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="20.0" styleClass="dialog-card dialog-card-body" maxWidth="Infinity">
                            <padding>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="4.0"/>
                            </padding>
                            <children>
                                <Label styleClass="heading-dialog heading-dialog-hero" text="Edit topic"/>

                                <VBox spacing="16.0" maxWidth="Infinity" styleClass="dialog-form-stack">
                                    <children>
                                        <VBox spacing="8.0" maxWidth="Infinity" styleClass="social-field-group">
                                            <children>
                                                <Label styleClass="field-label" text="Title"/>
                                                <TextField fx:id="titleField" maxWidth="Infinity" minHeight="40.0"
                                                           styleClass="text-field-social"/>
                                                <Label fx:id="errTitle" managed="false" maxWidth="Infinity"
                                                       styleClass="field-error" visible="false" wrapText="true"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0" maxWidth="Infinity" styleClass="social-field-group" VBox.vgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="field-label" text="Text"/>
                                                <TextArea fx:id="contentArea" maxWidth="Infinity" minHeight="120.0"
                                                          prefRowCount="5" styleClass="text-area-social" wrapText="true"/>
                                                <Label fx:id="errContent" managed="false" maxWidth="Infinity"
                                                       styleClass="field-error" visible="false" wrapText="true"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0" maxWidth="Infinity" styleClass="social-field-group">
                                            <children>
                                                <Label styleClass="field-label" text="Category"/>
                                                <ComboBox fx:id="categoryCombo" maxWidth="Infinity" minHeight="40.0"
                                                          styleClass="combo-social"/>
                                                <Label fx:id="errCategory" managed="false" maxWidth="Infinity"
                                                       styleClass="field-error" visible="false" wrapText="true"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0" maxWidth="Infinity" styleClass="social-field-group">
                                            <children>
                                                <Label styleClass="field-label" text="Status"/>
                                                <ComboBox fx:id="statusCombo" maxWidth="Infinity" minHeight="40.0"
                                                          styleClass="combo-social"/>
                                                <Label fx:id="errStatus" managed="false" maxWidth="Infinity"
                                                       styleClass="field-error" visible="false" wrapText="true"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0" maxWidth="Infinity" styleClass="social-field-group-muted">
                                            <children>
                                                <Label styleClass="field-label" text="Created"/>
                                                <TextField fx:id="createdField" editable="false" maxWidth="Infinity"
                                                           minHeight="40.0"
                                                           styleClass="text-field-social text-field-social-readonly"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <Label styleClass="label-muted label-muted-inline" maxWidth="Infinity" wrapText="true"
                                       text="“Last updated” is saved automatically when you click Save."/>

                                <HBox alignment="CENTER_RIGHT" spacing="12.0" maxWidth="Infinity">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#cancel" styleClass="btn-secondary"
                                                text="Cancel"/>
                                        <Button defaultButton="true" mnemonicParsing="false" onAction="#save"
                                                styleClass="btn-primary" text="Save"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
