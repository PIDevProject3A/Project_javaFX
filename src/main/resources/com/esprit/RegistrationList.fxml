<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>

<BorderPane xmlns:fx="http://javafx.com/fxml" stylesheets="@bledna-theme.css" fx:controller="com.esprit.controllers.RegistrationListController"
            prefWidth="1100" prefHeight="720" styleClass="root page-registrations">
    <top>
        <HBox styleClass="top-bar-page" alignment="CENTER_LEFT" spacing="14">
            <children>
                <Label text="🌿 Mes inscriptions" styleClass="top-bar-page-title"/>
                <Label text="bledna" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🏠 Catalogue" onAction="#handleBack" styleClass="btn-outline"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="14" style="-fx-padding: 20 26 28 26;">
            <children>
                <Label fx:id="participantBanner" styleClass="hint-banner"/>
                <VBox styleClass="filter-card">
                    <children>
                        <Label text="🔎 Recherche &amp; filtres" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <children>
                                <Label text="Événement"/>
                                <TextField fx:id="filterEventField" promptText="ex. Beach, nettoyage…" prefWidth="220"/>
                                <Label text="Paiement"/>
                                <ComboBox fx:id="filterPaymentCombo" prefWidth="150"/>
                                <Button text="🔍 Rechercher" onAction="#handleSearch" styleClass="btn-primary"/>
                            </children>
                        </HBox>
                        <Label fx:id="searchMessageLabel" text="Saisissez un nom d'événement ou choisissez un paiement puis cliquez sur Rechercher."
                               style="-fx-text-fill: #546e7a; -fx-font-size: 12px;"/>
                    </children>
                </VBox>
                <ListView fx:id="registrationList" minHeight="360" styleClass="list-view-registration" VBox.vgrow="ALWAYS"/>
            </children>
        </VBox>
    </center>
</BorderPane>

