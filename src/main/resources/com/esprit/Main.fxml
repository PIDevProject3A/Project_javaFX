<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" stylesheets="@bledna-theme.css" fx:controller="com.esprit.controllers.EventController" prefWidth="1000" prefHeight="600">
    <children>
        <!-- Titre -->
        <Label text="Gestion des Événements" layoutX="400" layoutY="15" style="-fx-font-size: 24; -fx-font-weight: bold;" />

        <!-- Liste des événements -->
        <ListView fx:id="eventList" layoutX="20" layoutY="60" prefWidth="960" prefHeight="350"/>

        <!-- Formulaire -->
        <VBox layoutX="20" layoutY="430" prefWidth="960" spacing="10" style="-fx-border-color: #cccccc; -fx-padding: 15;">
            <children>
                <Label text="Ajouter/Modifier un événement" style="-fx-font-weight: bold;" />
                <HBox spacing="10">
                    <children>
                        <TextField fx:id="nameField" promptText="Nom" prefWidth="150" />
                        <TextField fx:id="descriptionField" promptText="Description" prefWidth="200" />
                        <TextField fx:id="locationField" promptText="Lieu" prefWidth="100" />
                        <TextField fx:id="priceField" promptText="Prix" prefWidth="80" />
                        <TextField fx:id="typeField" promptText="Type" prefWidth="100" />
                    </children>
                </HBox>
                <HBox spacing="10">
                    <children>
                        <Button text="Ajouter" fx:id="addBtn" onAction="#handleAdd" style="-fx-padding: 8;" />
                        <Button text="Modifier" fx:id="updateBtn" onAction="#handleUpdate" style="-fx-padding: 8;" />
                        <Button text="Supprimer" fx:id="deleteBtn" onAction="#handleDelete" style="-fx-padding: 8; -fx-text-fill: white; -fx-background-color: #ff4444;" />
                        <Button text="Actualiser" fx:id="refreshBtn" onAction="#handleRefresh" style="-fx-padding: 8;" />
                        <Button text="Effacer" fx:id="clearBtn" onAction="#handleClear" style="-fx-padding: 8;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>


