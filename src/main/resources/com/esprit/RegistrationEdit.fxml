<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" stylesheets="@bledna-theme.css" fx:controller="com.esprit.controllers.RegistrationEditController"
            prefWidth="520" prefHeight="440" styleClass="root">
    <children>
        <VBox layoutX="28" layoutY="24" spacing="14" prefWidth="460">
            <children>
                <Label text="✏ Edit Registration" styleClass="label-title"/>
                <Label fx:id="eventTitleLabel" wrapText="true" styleClass="label-subtitle"/>
                <Label text="Amount and payment (fixed with the event, read-only)" style="-fx-font-weight: bold;"/>
                <Label fx:id="readOnlyAmountLabel" style="-fx-text-fill: #2e7d32; -fx-font-weight: bold;"/>
                <Label fx:id="readOnlyPaymentLabel"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="First Name *" prefWidth="100"/>
                        <TextField fx:id="firstNameField" prefWidth="300"/>
                    </children>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Last Name *" prefWidth="100"/>
                        <TextField fx:id="lastNameField" prefWidth="300"/>
                    </children>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Date *" prefWidth="100"/>
                        <DatePicker fx:id="registrationDatePicker" prefWidth="200"/>
                    </children>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Time *" prefWidth="100"/>
                        <TextField fx:id="registrationTimeField" promptText="HH:mm" prefWidth="120"/>
                    </children>
                </HBox>
                <HBox spacing="10" style="-fx-padding: 12 0 0 0;">
                    <children>
                        <Button fx:id="saveBtn" text="✓ Save" onAction="#handleSave" styleClass="btn-primary"/>
                        <Button fx:id="cancelBtn" text="Cancel" onAction="#handleCancel" styleClass="btn-secondary"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>

