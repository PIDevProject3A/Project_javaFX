<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.DatePicker?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.esprit.controllers.RegisterEventFormController"
            prefWidth="520" prefHeight="620" styleClass="root">
    <children>
        <VBox layoutX="28" layoutY="20" spacing="14" prefWidth="464">
            <children>
                <Label text="🌿 Inscription (bledna)" styleClass="label-title"/>
                <Label text="Inscription à l'événement" styleClass="label-subtitle"/>
                <Label fx:id="eventTitleLabel" wrapText="true" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
                <Label fx:id="eventDetailsLabel" wrapText="true" style="-fx-font-size: 13;"/>
                <Separator/>
                <Label text="Vos coordonnées" style="-fx-font-weight: bold; -fx-text-fill: #1b5e20;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Prénom *" prefWidth="100"/>
                        <TextField fx:id="firstNameField" promptText="Prénom" prefWidth="300"/>
                    </children>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Nom *" prefWidth="100"/>
                        <TextField fx:id="lastNameField" promptText="Nom" prefWidth="300"/>
                    </children>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Email *" prefWidth="100"/>
                        <TextField fx:id="emailField" promptText="ex. utilisateur@email.com" prefWidth="300"/>
                    </children>
                </HBox>
                <Separator/>
                <Label text="Date et heure d'inscription" style="-fx-font-weight: bold; -fx-text-fill: #1b5e20;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Date *" prefWidth="100"/>
                        <DatePicker fx:id="registrationDatePicker" prefWidth="200"/>
                    </children>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Heure *" prefWidth="100"/>
                        <TextField fx:id="registrationTimeField" promptText="ex. 14:30" prefWidth="120"/>
                    </children>
                </HBox>
                <Separator/>
                <Label text="Tarification (fixe, organisateur)" style="-fx-font-weight: bold; -fx-text-fill: #1b5e20;"/>
                <Label fx:id="fixedAmountLabel" wrapText="true" style="-fx-font-size: 14; -fx-text-fill: #2e7d32; -fx-font-weight: bold;"/>
                <Label fx:id="fixedPaymentLabel" wrapText="true" style="-fx-text-fill: #37474f;"/>
                <HBox spacing="12" style="-fx-padding: 18 0 0 0;">
                    <children>
                        <Button fx:id="submitBtn" text="✓ Confirmer l'inscription" onAction="#handleSubmit" styleClass="btn-primary"/>
                        <Button fx:id="cancelBtn" text="Annuler" onAction="#handleCancel" styleClass="btn-secondary"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
