<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" stylesheets="@bledna-theme.css" fx:controller="com.esprit.controllers.EventEditController" prefWidth="1000" prefHeight="600">
    <children>
        <VBox layoutX="150" layoutY="50" prefWidth="700" spacing="20" style="-fx-padding: 30;">
            <children>
                <!-- Title -->
                <Label text="✏️ Edit Event" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #333;" />

                <!-- Form -->
                <VBox spacing="15" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 20; -fx-background-color: #f9f9f9;">
                    <children>
                        <!-- Name -->
                        <VBox spacing="5">
                            <children>
                                <Label text="Event Name *" style="-fx-font-weight: bold;" />
                                <TextField fx:id="nameField" promptText="Enter name" style="-fx-padding: 10; -fx-font-size: 12;" />
                            </children>
                        </VBox>

                        <!-- Description -->
                        <VBox spacing="5">
                            <children>
                                <Label text="Description *" style="-fx-font-weight: bold;" />
                                <TextArea fx:id="descriptionField" promptText="Enter description" wrapText="true" prefRowCount="3" prefWidth="660" style="-fx-font-size: 12;" />
                            </children>
                        </VBox>

                        <!-- Location and Price -->
                        <HBox spacing="15">
                            <children>
                                <VBox spacing="5" prefWidth="350">
                                    <children>
                                        <Label text="Location *" style="-fx-font-weight: bold;" />
                                        <TextField fx:id="locationField" promptText="Enter location" style="-fx-padding: 10; -fx-font-size: 12;" />
                                    </children>
                                </VBox>
                                <VBox spacing="5" prefWidth="300">
                                    <children>
                                        <Label text="Price *" style="-fx-font-weight: bold;" />
                                        <TextField fx:id="priceField" promptText="Enter price" style="-fx-padding: 10; -fx-font-size: 12;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Type and Slots -->
                        <HBox spacing="15">
                            <children>
                                <VBox spacing="5" prefWidth="350">
                                    <children>
                                        <Label text="Event Type *" style="-fx-font-weight: bold;" />
                                        <ComboBox fx:id="typeCombo" promptText="Choose..." style="-fx-padding: 10; -fx-font-size: 12;" />
                                    </children>
                                </VBox>
                                <VBox spacing="5" prefWidth="300">
                                    <children>
                                        <Label text="Max slots *" style="-fx-font-weight: bold;" />
                                        <TextField fx:id="maxPlacesField" promptText="100" style="-fx-padding: 10; -fx-font-size: 12;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Buttons -->
                <HBox spacing="15" style="-fx-alignment: CENTER;">
                    <children>
                        <Button text="✅ Save changes" fx:id="saveBtn" onAction="#handleSave" style="-fx-padding: 12 30; -fx-font-size: 14; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;" />
                        <Button text="❌ Cancel" fx:id="cancelBtn" onAction="#handleCancel" style="-fx-padding: 12 30; -fx-font-size: 14; -fx-background-color: #757575; -fx-text-fill: white; -fx-cursor: hand;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>

