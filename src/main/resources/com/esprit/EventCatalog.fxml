<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" stylesheets="@bledna-theme.css" fx:controller="com.esprit.controllers.EventCatalogController" prefWidth="1150" prefHeight="760" styleClass="root">
    <children>
        <VBox layoutX="16" layoutY="12" spacing="10" prefWidth="1118">
            <children>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <children>
                        <Label text="%catalog.title" styleClass="label-title"/>
                        <Button text="🏠 %nav.dashboard" onAction="#handleHome" styleClass="btn-outline"/>
                        <Button text="📋 %reglist.title" onAction="#handleOpenRegistrations" styleClass="btn-secondary"/>
                        <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
                        <HBox styleClass="impact-globe-container">
                            <children>
                                <Label text="🌍" styleClass="impact-globe-icon"/>
                                <Label text="GLOBAL IMPACT" styleClass="impact-globe-text"/>
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <Label fx:id="tomorrowReminderLabel" managed="false" visible="false" wrapText="true" maxWidth="1080"/>
                <ListView fx:id="eventList" prefWidth="1118" prefHeight="620" styleClass="list-view-registration"/>
            </children>
        </VBox>
    </children>
</AnchorPane>

