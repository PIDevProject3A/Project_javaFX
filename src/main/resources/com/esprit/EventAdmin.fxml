<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>

<BorderPane xmlns:fx="http://javafx.com/fxml" stylesheets="@bledna-theme.css" fx:controller="com.esprit.controllers.EventAdminController" prefWidth="1150" prefHeight="760" styleClass="app-shell">
    <left>
        <VBox styleClass="sidebar">
            <Label text="BLADNA" styleClass="sidebar-title"/>
            <Label text="Admin Dashboard" styleClass="sidebar-subtitle"/>
            
            <Region prefHeight="20"/>
            
            <Button text="Dashboard" onAction="#handleHome" styleClass="nav-button">
                <graphic>
                    <Label text="&#x1F3E0;" styleClass="icon-label"/>
                </graphic>
            </Button>
            <Button text="Manage Accounts" onAction="#goToManageAccounts" styleClass="nav-button">
                <graphic>
                    <Label text="&#x1F465;" styleClass="icon-label"/>
                </graphic>
            </Button>
            <Button text="Event Registration" onAction="#goToEventRegistrations" styleClass="nav-button">
                <graphic>
                    <Label text="&#x1F4CB;" styleClass="icon-label"/>
                </graphic>
            </Button>
            <Button text="Manage Events" styleClass="nav-button, nav-button-active">
                <graphic>
                    <Label text="&#x1F4C5;" styleClass="icon-label"/>
                </graphic>
            </Button>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <Button text="Logout" onAction="#logout" styleClass="nav-button, nav-button-logout">
                <graphic>
                    <Label text="&#x2B05;" styleClass="icon-label"/>
                </graphic>
            </Button>
        </VBox>
    </left>
    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <children>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <children>
                        <Label text="🌿 bledna — Administration" styleClass="label-title"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="➕ Nouvel événement" fx:id="addBtn" onAction="#handleAddEvent" styleClass="btn-primary"/>
                    </children>
                </HBox>
                <ListView fx:id="eventList" VBox.vgrow="ALWAYS" styleClass="list-view-registration"/>
            </children>
        </VBox>
    </center>
</BorderPane>

