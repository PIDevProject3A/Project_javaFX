<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FaceIdAdminManagementController" stylesheets="@style.css">
    <left>
        <VBox styleClass="sidebar">
            <Label text="Green Desk" styleClass="sidebar-title"/>
            <Label text="Face ID Admin" styleClass="sidebar-subtitle"/>
            <Button text="[Back] Dashboard" onAction="#goBack" styleClass="nav-button"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="content-area">
            <VBox styleClass="page-card" maxWidth="760" spacing="12">
                <Label text="Gestion Face ID" styleClass="title"/>
                <Label text="Selectionnez un utilisateur puis ajoutez, modifiez ou supprimez son Face ID." styleClass="subtitle" wrapText="true"/>

                <Label text="Utilisateur" styleClass="form-label"/>
                <ComboBox fx:id="userBox" promptText="Selectionner un utilisateur" maxWidth="Infinity"/>

                <Label text="Statut" styleClass="form-label"/>
                <Label fx:id="faceIdStatusLabel" styleClass="subtitle" text="Aucun utilisateur selectionne."/>

                <Label text="Image selectionnee" styleClass="form-label"/>
                <Label fx:id="selectedImageLabel" styleClass="subtitle" text="Aucune image"/>

                <HBox spacing="10">
                    <Button text="Choisir image" onAction="#handlePickImage" styleClass="secondary-button"/>
                    <Button text="Ajouter Face ID" onAction="#handleAddFaceId" styleClass="primary-button"/>
                    <Button text="Modifier Face ID" onAction="#handleModifyFaceId" styleClass="secondary-button"/>
                    <Button text="Supprimer Face ID" onAction="#handleDeleteFaceId" styleClass="danger-button"/>
                </HBox>

                <Label fx:id="messageLabel" styleClass="status-message" wrapText="true"/>
            </VBox>
            <padding>
                <Insets top="6" right="6" bottom="6" left="6"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>

