<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<StackPane styleClass="login-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.LoginController" stylesheets="@style.css">
    <VBox alignment="CENTER" spacing="20" maxWidth="1000">
        <padding>
            <Insets top="20" right="40" bottom="20" left="40"/>
        </padding>
        
        <!-- Appearance Control Bar -->
        <HBox fx:id="appearanceBar" spacing="12" alignment="TOP_RIGHT">
            <padding>
                <Insets bottom="10"/>
            </padding>
        </HBox>

        <VBox alignment="CENTER" spacing="4">
            <Label text="BLADNA" styleClass="brand-title" style="-fx-font-size: 48px;"/>
            <Label text="%login.brand.subtitle" styleClass="brand-subtitle" wrapText="true" alignment="CENTER" textAlignment="CENTER" maxWidth="400"/>
        </VBox>

        <VBox styleClass="login-card" spacing="15" maxWidth="400" minWidth="360">
            <VBox spacing="4">
                <Label text="%login.title" styleClass="title" style="-fx-font-size: 28px;"/>
                <Label text="%login.subtitle" styleClass="subtitle" wrapText="true" style="-fx-font-size: 14px;"/>
            </VBox>

            <VBox spacing="8">
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="✉" styleClass="icon-label"/>
                        <Label text="%login.email" styleClass="form-label"/>
                    </HBox>
                    <TextField fx:id="emailField" promptText="name@domain.com"/>
                </VBox>
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="🔒" styleClass="icon-label"/>
                        <Label text="%login.password" styleClass="form-label"/>
                    </HBox>
                    <PasswordField fx:id="passwordField" promptText="Your password"/>
                </VBox>
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="🛡" styleClass="icon-label"/>
                        <Label text="%login.verification" styleClass="form-label"/>
                    </HBox>
                    <WebView fx:id="recaptchaView" prefHeight="90" minHeight="90" maxHeight="90"/>
                </VBox>
            </VBox>

            <VBox spacing="8">
                <Button text="%login.btn.signin" onAction="#handleLogin" styleClass="primary-button" maxWidth="Infinity"/>
                <Button text="%login.btn.faceid" onAction="#handleFaceLogin" styleClass="secondary-button" maxWidth="Infinity" prefHeight="38">
                    <graphic>
                        <Label text="📷" styleClass="icon-label" style="-fx-font-size: 14px;"/>
                    </graphic>
                </Button>
            </VBox>
            
            <Label fx:id="messageLabel" styleClass="status-message" wrapText="true" visible="false" managed="false" alignment="CENTER" maxWidth="Infinity"/>
        </VBox>
    </VBox>
</StackPane>

